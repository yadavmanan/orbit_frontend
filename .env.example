# Copy to .env.production (or set as build env vars in your hosting provider)
# and point it at your deployed backend, e.g. Render/Fly/Cloudflare Workers.
#
# Leave unset for local dev — Vite's dev server proxies /api to
# http://localhost:8000 automatically (see vite.config.ts).
#
# For Vercel: Set this as an Environment Variable in your Project Settings
# (Build & Development Settings > Environment Variables)
VITE_API_BASE=https://orbit-backend-p6tn.onrender.com/api
